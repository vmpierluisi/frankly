# For running the backend outside docker. In normal use, `docker compose up`
# reads the root /.env and injects these. Copy to backend/.env and fill in.

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# SQLite for local dev; a postgresql:// URL enables Alembic migrations on boot.
DATABASE_URL=sqlite:///./hiring_sim.db

# Auth — leave Supabase blank only when DEV_MODE=true.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
MANAGER_EMAILS=
# Change ADMIN_PASSWORD for any real deployment; DEV_MODE=true bypasses ALL auth.
ADMIN_PASSWORD=changeme-admin
DEV_MODE=false

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SIM_ROLLOUTS_CONCURRENCY=5
SIM_JUDGES_PER_ROLLOUT=2
SIM_DEFAULT_TEAM_SIZE=5
MATCH_COST_CEILING_USD=5.00
OPENROUTER_GLOBAL_CONCURRENCY=16
