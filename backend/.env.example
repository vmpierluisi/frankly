# This file mirrors the root .env.example for running the backend outside docker.
# In normal use, `docker compose up` reads the root /.env and injects these.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_X_TITLE=hiring-sim-v0

MANAGER_USERNAME=manager
MANAGER_PASSWORD=changeme

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./hiring_sim.db

SIM_ROLLOUTS_CONCURRENCY=5
SIM_JUDGES_PER_ROLLOUT=2
SIM_DEFAULT_TEAM_SIZE=5
MATCH_COST_CEILING_USD=5.00
OPENROUTER_GLOBAL_CONCURRENCY=16
