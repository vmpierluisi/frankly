# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# `docker compose up` reads this file and injects it into both services.

# ---------- OpenRouter (LLM access) ----------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Swappable without code changes. Any OpenAI-compatible model on OpenRouter works.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional: attribution headers shown on openrouter.ai dashboards
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_X_TITLE=hiring-sim-v0

# ---------- Database ----------
# Local/dev default is SQLite. For production use a Postgres URL (e.g. Supabase
# session pooler); a `postgresql://` URL makes the app run Alembic on startup.
DATABASE_URL=sqlite:////data/hiring_sim.db

# ---------- Supabase (auth) ----------
# Backend verifies Supabase JWTs via JWKS. Leave blank only when DEV_MODE=true.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Derived from SUPABASE_URL if left blank.
SUPABASE_JWKS_URL=

# ---------- Roles / auth ----------
# Comma-separated Google emails that get the manager role. Everyone else is a
# candidate.
MANAGER_EMAILS=
# Bearer token guarding /admin/* routes. CHANGE THIS for any real deployment —
# the default below is public in the repo.
ADMIN_PASSWORD=changeme-admin
# DEV_MODE=true BYPASSES ALL AUTH and treats every request as a manager.
# Local development only — never set true in a deployed/public environment.
DEV_MODE=false

# ---------- Backend ----------
BACKEND_PORT=8000
# CORS: frontend origin(s), comma-separated. Do not use "*" with credentials.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Simulation pipeline ----------
SIM_ROLLOUTS_CONCURRENCY=5
SIM_JUDGES_PER_ROLLOUT=2
SIM_DEFAULT_TEAM_SIZE=5
MATCH_COST_CEILING_USD=5.00
OPENROUTER_GLOBAL_CONCURRENCY=16

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
# Mirror of the Supabase values above, exposed to the browser build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Mirror of MANAGER_EMAILS, for client-side role routing only.
VITE_MANAGER_EMAILS=
