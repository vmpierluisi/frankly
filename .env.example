# ---------- OpenRouter (LLM access) ----------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Swappable without code changes. Any OpenAI-compatible model on OpenRouter works.
# Default is anthropic/claude-sonnet-4.6 per the project brief.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional: attribution header shown on openrouter.ai dashboards
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_X_TITLE=hiring-sim-v0

# ---------- Manager auth (shared-password basic auth) ----------
# Change this. Anyone with this password can CRUD companies and see candidate
# scores. Candidate intake is public.
MANAGER_USERNAME=manager
MANAGER_PASSWORD=changeme

# ---------- Backend ----------
BACKEND_PORT=8000
# CORS: frontend origin(s), comma-separated
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite path inside the backend container. The docker volume mounts here.
DATABASE_URL=sqlite:////data/hiring_sim.db

# ---------- Frontend ----------
FRONTEND_PORT=5173
# Injected into the Vite build at image-build time
VITE_API_BASE_URL=http://localhost:8000
